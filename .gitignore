.claude/settings.local.json

/mib/ImportExportTools/Imaris/mibConnectToImaris.m

/mib/external/Fiji

# graphify
# NOTE: git has no trailing comments in .gitignore - a '#' only starts a comment
# at the start of a line. These three rules previously carried inline comments,
# which made them match nothing, so all three paths were committed by accident.
# manifest.json is mtime-based and breaks after a git clone
graphify-out/manifest.json
# cost.json is local only
graphify-out/cost.json
# cache/ can be committed for speed, or skipped to keep the repo small
graphify-out/cache/

# Scratch space - docs/CLAUDE.md calls temp/ scratch only, and its cached zarr
# stores carry the internal paths of whoever produced them. Never commit it.
temp/

# Compiled standalone build output, regenerated from mib/ by deploymentScript.m
deployed/
